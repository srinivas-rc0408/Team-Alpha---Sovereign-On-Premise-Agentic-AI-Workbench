# Copy to .env and adjust as needed. All values shown are the built-in defaults.

# Ollama server
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen2.5:7b
# Vision model. qwen2.5vl:3b reads gauge displays and P&ID/drawing text well.
# On a very-low-VRAM machine you can fall back to the lighter (gist-only)
# moondream: set VISION_MODEL=moondream and run: ollama pull moondream
VISION_MODEL=qwen2.5vl:3b
EMBED_MODEL=nomic-embed-text

# RAG index
DOCS_DIR=docs
INDEX_DIR=data/embeddings
RAG_TOP_K=4

# Sandboxed calculator (core/tools.py)
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_TIMEOUT=10

# Tamper-evident audit log
AUDIT_LOG=logs/audit.jsonl

# Operator-supplied safety thresholds (never pre-populated by AEGIS)
SAFETY_LIMITS_FILE=config/safety_limits.json

# Local chat history (one JSON file per session)
CHATS_DIR=data/chats

# -- Telemetry / phone-home switches - all disabled --------------------------
# core/__init__.py force-sets every one of these at import time, before
# langchain/langsmith can read them, so editing these lines cannot re-enable
# it. Listed here only so the offline guarantee is visible without reading
# the source; install.sh/install.ps1 add this block automatically if a .env
# predates it.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_TRACING=false
LANGSMITH_TRACING=false
LANGCHAIN_ENDPOINT=
ANONYMIZED_TELEMETRY=false
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=1
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
