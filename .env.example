# Copy to .env and adjust as needed. All values shown are the built-in defaults.

# Ollama server
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen2.5:7b
VISION_MODEL=moondream
EMBED_MODEL=nomic-embed-text

# RAG index
DOCS_DIR=docs
INDEX_DIR=data/embeddings
RAG_TOP_K=4

# Sandboxed calculator (core/tools.py)
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_TIMEOUT=10

# Tamper-evident audit log
AUDIT_LOG=logs/audit.jsonl

# Operator-supplied safety thresholds (never pre-populated by AEGIS)
SAFETY_LIMITS_FILE=config/safety_limits.json
